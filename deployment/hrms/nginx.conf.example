# Install as a NEW site only after checking the existing nginx -T output.
# Replace HRMS_HOSTNAME and HRMS_HTTP_PORT with the verified deployment values.
# Add TLS for this hostname using the server's existing certificate procedure.
server {
    listen 80;
    server_name HRMS_HOSTNAME;
    client_max_body_size 12m;
    location / {
        proxy_pass http://127.0.0.1:HRMS_HTTP_PORT;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
