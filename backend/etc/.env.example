# POSTGRES_USERNAME/POSTGRES_PASSWORD are substituted directly into a connection string by
# Docker Compose — avoid @ : / ? # % in these values or the resulting URL will be malformed.
# Stick to letters, numbers, - and _.
POSTGRES_HOST=modular-db
POSTGRES_PORT=5432
POSTGRES_USERNAME=statemachine
POSTGRES_PASSWORD=statemachine
POSTGRES_DATABASE=statemachine
DATABASE_URL=postgresql://statemachine:statemachine@modular-db:5432/statemachine
SQLALCHEMY_DATABASE_MIGRATION_URL=postgresql://statemachine:statemachine@modular-db:5432/statemachine
ALEMBIC_CONFIG_PATH=/app/backend/alembic.ini
POSTGRES_APP_SCHEMA=modular_backend
REQUEST_TIMEOUT_SECONDS=60
HOST=0.0.0.0
PORT=8001
REDIS_HOST=modular-redis
REDIS_PORT=6380
REDIS_PASSWORD=local-dev-redis-pass
FILEHANDLER_ENTITY_TYPE_SLUG_MAX_LENGTH=64

# Bulk import worker (background analysis/commit processing — see
# design_docs/tony_bulk_import_worker_handoff.md). BULK_IMPORT_WORKER_ENABLED should only be
# set to true on the dedicated worker container/process, same pattern as ACTION_RUNS_WORKER_ENABLED.
BULK_IMPORT_WORKER_ENABLED=true
BULK_IMPORT_WORKER_POLL_INTERVAL_SECONDS=2.0
BULK_IMPORT_WORKER_POLL_BATCH_SIZE=5
BULK_IMPORT_WORKER_ERROR_BACKOFF_SECONDS=5.0
BULK_IMPORT_WORKER_SHUTDOWN_JOIN_SECONDS=5.0
BULK_IMPORT_SWEEP_INTERVAL_SECONDS=30.0
BULK_IMPORT_SWEEP_BATCH_SIZE=25
BULK_IMPORT_STALE_THRESHOLD_SECONDS=600
BULK_IMPORT_RECENT_JOBS_LIMIT=50

OPENAI_API_KEY=
MODULAR_INCLUDE_ORIGINAL_APP_ROUTES=false
MODULAR_INCLUDE_ORIGINAL_V1_PREFIX=false
MODULAR_BYPASS_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5111/auth/google/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_TENANT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:5111/auth/microsoft/callback
MICROSOFT_OAUTH_STATE_SECRET=
MICROSOFT_OAUTH_STATE_TTL_SECONDS=600
ENABLE_MICROSOFT_SSO=true
# REQUIRED — no default is provided, the app will not start without this set.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=


# Default system role display names, priorities, and colors
ROLE_ADMIN_DISPLAY_NAME=Admin
ROLE_ADMIN_PRIORITY=100
ROLE_ADMIN_COLOR=#DC2626
ROLE_VIEWER_DISPLAY_NAME=Viewer
ROLE_VIEWER_PRIORITY=10
ROLE_VIEWER_COLOR=#6B7280


# LLM validation models (cheapest model per provider used to verify API keys)
LLM_VALIDATION_MODEL_OPENAI=gpt-4o-mini
LLM_VALIDATION_MODEL_ANTHROPIC=claude-haiku-3-5-20241022
LLM_VALIDATION_MODEL_GOOGLE_GEMINI=gemini/gemini-1.5-flash

# SLA risk thresholds (hours remaining before a pipeline card is flagged)
SLA_WARNING_HOURS=8
SLA_CRITICAL_HOURS=2

# Path to config.ini — domains and other defaults are read from there
CONFIG_INI_PATH=./etc/config.ini

DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
PLATFORM_ORG_ID=00000000-0000-0000-0000-000000000000

# Field library request-validation length limits. Each is clamped to the column
# width fixed by migration 202608180002 (name 256, key 128, type code 64), so
# these can only narrow what the API accepts, never widen it past the database.
# Leave unset to accept the full column width.
FIELD_LIBRARY_NAME_MAX_LENGTH=256
FIELD_LIBRARY_KEY_MAX_LENGTH=128
FIELD_LIBRARY_TYPE_CODE_MAX_LENGTH=64

# Internal addresses outbound calls (connectors, remote file fetches) may reach,
# as a comma-separated list of IPs or CIDR blocks. Unset means none: every private,
# loopback and reserved address stays blocked, which is correct for SaaS.
#
# Set this only on a self-hosted deployment that runs a co-located service on an
# internal network. Listing an address exempts that address alone — everything else
# internal stays blocked, and listed hosts are still pinned to the resolved IP, so
# DNS rebinding is still defended. Prefer a CIDR for container networks: Docker
# reassigns service IPs on recreate.
#
# Link-local (169.254.0.0/16, fe80::/10) is refused whatever you put here — it is the
# cloud metadata endpoint.
#
# Example: OUTBOUND_HTTP_ALLOWED_INTERNAL_IPS=10.252.5.4/32,172.18.0.0/16
OUTBOUND_HTTP_ALLOWED_INTERNAL_IPS=
