VITE_DEV_PROXY_TARGET=http://localhost:8001
# Set to 'true' to skip authentication (local dev only). Defaults to false when unset.
VITE_BYPASS_AUTH=false
VITE_GOOGLE_CLIENT_ID=
# Override the org ID used in bypass-auth mode (optional)
VITE_BYPASS_ORG_ID=
# Number of activity timeline events to load per page. Defaults to 25.
VITE_TIMELINE_PAGE_SIZE=25
