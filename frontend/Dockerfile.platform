FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV VITE_SKIN_ID=newtuple-hrms-native
ARG HRMS_RELEASE_SHA=development
ENV VITE_HRMS_RELEASE_SHA=$HRMS_RELEASE_SHA
ENV VITE_API_BASE_URL=/v1/api
ENV CUSTOMER_SKINS_PATH=/app/src/skins/hrms_native/customer-skins.ts
RUN sed -i 's|/src/main.tsx|/src/skins/hrms_native/main.tsx|' index.html
RUN sed -i 's|/favicon.svg|/hrms-brand/myhub-favicon.svg|' index.html
RUN sed -i 's|<title>State Machine</title>|<title>Newtuple HRMS</title>|' index.html
RUN npm run build

FROM nginx:alpine
COPY deploy/platform.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
