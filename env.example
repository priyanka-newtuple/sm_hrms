# Environment
ENV=development

# Database Configuration
# NOTE: When running in Docker, docker-compose.yml automatically constructs DATABASE_URL
# using port 5432 (container port). The DATABASE_URL here is for local development.
# POSTGRES_PORT is the host port mapping (for external access), container always uses 5432
# POSTGRES_USERNAME/POSTGRES_PASSWORD are substituted directly into a connection string by
# Docker Compose — avoid @ : / ? # % in these values or the resulting URL will be malformed.
# Stick to letters, numbers, - and _.
DATABASE_URL=postgresql+psycopg2://statemachine:statemachine@db:5432/statemachine
POSTGRES_DB=statemachine
POSTGRES_USER=statemachine
POSTGRES_PASSWORD=statemachine
POSTGRES_DATABASE=statemachine
POSTGRES_USERNAME=statemachine

# Redis Configuration
# REQUIRED — docker-compose.local.yml will refuse to start modular-redis without this set.
# Same character restriction as POSTGRES_PASSWORD above.
REDIS_PASSWORD=local-dev-redis-pass

# Database Settings
SQL_ECHO=false
USE_CREATE_ALL=true

# Logging
LOG_JSON=false

# LiteLLM / Agent Settings
LITELLM_MODEL=claude-sonnet-4-20250514
AGENT_MAX_ITERATIONS=10
AGENT_TRACE_ENABLED=true
AGENT_TRACE_TTL_DAYS=30

# Provider API Keys (add your actual keys here)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Transcription (fallback defaults; org-level config preferred)
TRANSCRIPTION_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=
TRANSCRIPTION_BOT_BASE_URL=
CHROME_EXTENSION_PATH=
CORS_ALLOW_ORIGIN_REGEX=

# Inbound Email (SES -> S3 -> SNS)
# Domain used for org intake addresses: intake-{org-slug}@<domain>
INBOUND_EMAIL_DOMAIN=ats.newtuple.com
# Optional shared secret for webhook validation (send as X-Webhook-Token)
INBOUND_EMAIL_WEBHOOK_SECRET=
# Optional: restrict allowed S3 bucket for inbound emails
INBOUND_EMAIL_ALLOWED_BUCKET=
# Optional AWS credentials for S3 access (otherwise uses IAM role/default creds)
INBOUND_EMAIL_S3_REGION=
INBOUND_EMAIL_S3_ACCESS_KEY_ID=
INBOUND_EMAIL_S3_SECRET_ACCESS_KEY=

# Optional: LiteLLM API base for custom endpoints
LITELLM_API_BASE=

# JWT Settings
# REQUIRED — no default is provided, the app will not start without this set.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for sensitive data at rest (API keys, etc.)
# In development, falls back to JWT_SECRET_KEY if not set
# Required in production - use a strong random string
ENCRYPTION_KEY=

# Google OAuth Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=

# Auth Settings
ALLOW_REGISTRATION=true

# Frontend Configuration
VITE_DEV_PROXY_TARGET=http://backend:8000
# URL for email links (use your production domain in production)
FRONTEND_URL=http://localhost:5173

# Port Configuration
# POSTGRES_PORT: Host port mapping (for external access from your machine)
# Inside Docker, services always connect using container port 5432
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Bootstrap (startup provisioning)
BOOTSTRAP_ORG_ID=
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=

# Create an initial admin user on startup (set email to enable)
BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
BOOTSTRAP_ADMIN_PASSWORD=admin

# Optional: also create a platform super-admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=